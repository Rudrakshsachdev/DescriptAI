# =============================================================================
# Descript AI — Backend Configuration Environment Template
# =============================================================================

# Server Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["*"]

# Model Checkpoint Path & Fallback
MODEL_CHECKPOINT_PATH=checkpoints/sft/best_checkpoint
MODEL_FALLBACK_ID=google/flan-t5-small

# Inference Device ('auto', 'cuda', 'cpu')
DEVICE=auto
USE_HALF_PRECISION=true

# Generation Defaults (Beam-2 Recommended from Step 9 Held-Out Evaluation)
DEFAULT_NUM_BEAMS=2
DEFAULT_MAX_NEW_TOKENS=128
DEFAULT_MIN_NEW_TOKENS=10
DEFAULT_NO_REPEAT_NGRAM_SIZE=3
DEFAULT_LENGTH_PENALTY=1.0

# Reliability & Concurrency
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_CAPACITY_WAIT_SECONDS=0.25
MAX_CONCURRENT_INFERENCE_REQUESTS=1
